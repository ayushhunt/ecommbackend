// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Test {
  id    Int     @id @default(autoincrement())
  name  String
  email String
}

enum AddressType {
  HOME
  OFFICE
  FRIEND
  FAMILY
  BUSINESS
  OTHER
}

model User {
  id            String    @id @default(uuid())
  provider      String    // "email", "google", "github"
  providerId    String?   // Nullable for email users
  email         String    @unique
  passwordHash  String?   // Nullable for SSO users
  verified      Boolean   @default(false)
  name          String?
  role          String    @default("user") // "user", "admin"
  phoneNumber   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  addresses     Address[]
  Verification  Verification[]
  RefreshToken RefreshToken[]
}


model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name         String @default("Home")     // Custom name like "Home", "Office", "Mom's House"
  addressType  AddressType @default(HOME)
  addressLine1 String      // Primary street address
  addressLine2 String?     // Apartment, suite, unit, building, floor, etc.
  landmark     String?
  phoneNumber   String?
  neighborhood String?     // Area/locality/suburb
  city         String      // City/town
  state        String?     // State/province/region (optional for some countries)
  postalCode   String?     // ZIP/postal code (optional for some countries)
  country      String      @default("IN") 
  isDefault    Boolean     @default(false)  // Add this line
  isActive     Boolean     @default(true)   // Optional: Add this too for soft delete
  deliveryInstructions String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@index([country])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model Verification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type     String   
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  otp       String?  // Optional: if you want to use OTP instead of token
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("password_resets")
}